{
  "expo": {
    "name": "PomoDuo",
    "slug": "PomoDuo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pomoduo-icon.jpg",
    "scheme": "pomoduo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/pomoduo-icon.jpg",
      "bundleIdentifier": "com.rainieraquino.pomoduo",
      "buildNumber": "1"
    },
    "android": {
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rainieraquino.pomoduo",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": ["specialUse"],
              "specialUseSubtype": "Timer for focus sessions"
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/pomoduo-splash.jpg",
            "imageWidth": 1024
          }
        }
      ],
      "./withAndroidAlarmSound.js",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "adae8876-1fda-44b6-a3de-8c8ddad448fa"
      }
    }
  }
}
