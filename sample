      // Simple toggle logic for Global vs Friends
      const globalBtn = document.getElementById("global-toggle");
      const friendsBtn = document.getElementById("friends-toggle");

      function setActive(active, inactive) {
        active.classList.add(
          "bg-primary-container",
          "text-on-primary-container",
        );
        active.classList.remove(
          "text-on-surface-variant",
          "hover:bg-surface-variant/40",
        );

        inactive.classList.remove(
          "bg-primary-container",
          "text-on-primary-container",
        );
        inactive.classList.add(
          "text-on-surface-variant",
          "hover:bg-surface-variant/40",
        );
      }

      globalBtn.addEventListener("click", () =>
        setActive(globalBtn, friendsBtn),
      );
      friendsBtn.addEventListener("click", () =>
        setActive(friendsBtn, globalBtn),
      );

      // Interaction Micro-effect
      document.querySelectorAll("a, button").forEach((el) => {
        el.addEventListener("mousedown", () => {
          el.style.transform = "scale(0.96)";
        });
        el.addEventListener("mouseup", () => {
          el.style.transform = "";
        });
        el.addEventListener("mouseleave", () => {
          el.style.transform = "";
        });
      });
