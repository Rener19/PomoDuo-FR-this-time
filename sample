    <script>
      // Simple Timer Logic for demonstration
      let timeLeft = 1500; // 25 minutes
      let timerId = null;
      const totalTime = 1500;
      const timerText = document.getElementById("timer-text");
      const timerProgress = document.getElementById("timer-progress");
      const toggleBtn = document.getElementById("toggle-timer");
      const playIcon = document.getElementById("play-icon");
      const playText = document.getElementById("play-text");

      function updateDisplay() {
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        timerText.textContent = `${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;

        // Progress circle (dashoffset)
        const circumference = 2 * Math.PI * 90;
        const offset = circumference - (timeLeft / totalTime) * circumference;
        timerProgress.style.strokeDashoffset = offset;
      }

      toggleBtn.addEventListener("click", () => {
        if (timerId) {
          clearInterval(timerId);
          timerId = null;
          playIcon.textContent = "play_arrow";
          playText.textContent = "Start Focus";
          toggleBtn.classList.remove("bg-primary-container");
          toggleBtn.classList.add("bg-primary");
        } else {
          timerId = setInterval(() => {
            if (timeLeft > 0) {
              timeLeft--;
              updateDisplay();
            } else {
              clearInterval(timerId);
            }
          }, 1000);
          playIcon.textContent = "pause";
          playText.textContent = "Pause Focus";
          toggleBtn.classList.remove("bg-primary");
          toggleBtn.classList.add("bg-primary-container");
        }
      });

      // Initialize display
      updateDisplay();
    </script>
